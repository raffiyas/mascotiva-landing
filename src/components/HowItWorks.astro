---
import { siteConfig } from '@data/siteConfig';
import Container from './Container.astro';
import StepCard from './StepCard.astro';

const { howItWorks } = siteConfig;
---

<section id="como-funciona" class="section-padding bg-white">
  <Container>
    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-balance mb-4">
        {howItWorks.sectionTitle}
      </h2>
      <p class="text-lg text-text-light max-w-2xl mx-auto">
        {howItWorks.sectionSubtitle}
      </p>
    </div>

    <!-- Steps -->
    <div class="space-y-12 md:space-y-16 max-w-4xl mx-auto">
      {howItWorks.steps.map((step, index) => (
        <StepCard
          number={step.number}
          title={step.title}
          description={step.description}
          icon={step.icon}
          isLast={index === howItWorks.steps.length - 1}
        />
      ))}
    </div>
  </Container>
</section>
