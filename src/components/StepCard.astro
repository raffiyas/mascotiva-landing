---
/**
 * StepCard component - displays a single step in the process
 */

export interface Props {
  number: number;
  title: string;
  description: string;
  icon?: string;
  isLast?: boolean;
}

const { number, title, description, icon, isLast = false } = Astro.props;

// Alt text mapping for step icons
const altTextMap: Record<string, string> = {
  '/images/icon-demo.png': 'Icono de videollamada para agendar demo',
  '/images/icon-config.png': 'Icono de configuración y personalización',
  '/images/icon-launch.png': 'Icono de inicio de operación',
};

const altText = icon ? (altTextMap[icon] || title) : title;
---

<div class="relative flex flex-col md:flex-row items-start md:items-center gap-6">
  <!-- Step Number & Icon -->
  <div class="flex-shrink-0 relative z-10">
    <div class="w-20 h-20 rounded-xl bg-accent flex items-center justify-center shadow-card">
      {icon ? (
        <img
          src={icon}
          alt={altText}
          class="w-16 h-16 object-contain"
          width="64"
          height="64"
        />
      ) : (
        <span class="text-4xl font-bold text-white">{number}</span>
      )}
    </div>
  </div>

  <!-- Connecting Line (desktop only, not for last item) -->
  {!isLast && (
    <div class="hidden md:block absolute top-10 left-20 w-full h-1 bg-gradient-to-r from-accent to-accent/20 -z-0" aria-hidden="true" />
  )}

  <!-- Content -->
  <div class="flex-1 md:pl-6">
    <h3 class="text-2xl font-bold text-primary mb-3">
      {title}
    </h3>
    <p class="text-text-light leading-relaxed max-w-md">
      {description}
    </p>
  </div>
</div>
