---
/**
 * StepCard component - displays a single step in a vertical timeline
 * Features:
 * - Left column: icon with vertical connecting line
 * - Right column: title and description
 * - Clean, professional SaaS-style onboarding flow
 */

export interface Props {
  number: number;
  title: string;
  description: string;
  icon?: string;
  isLast?: boolean;
}

const { number, title, description, icon, isLast = false } = Astro.props;

// Alt text mapping for step icons
const altTextMap: Record<string, string> = {
  '/images/icon-demo.png': 'Icono de videollamada para agendar demo',
  '/images/icon-config.png': 'Icono de configuración y personalización',
  '/images/icon-launch.png': 'Icono de inicio de operación',
};

const altText = icon ? (altTextMap[icon] || title) : title;
---

<div class="relative flex gap-6 md:gap-8">
  <!-- Left Column: Icon + Vertical Line -->
  <div class="flex flex-col items-center flex-shrink-0">
    <!-- Icon Container -->
    <div class="w-12 h-12 md:w-14 md:h-14 rounded-lg bg-accent flex items-center justify-center shadow-md relative z-10">
      {icon ? (
        <img
          src={icon}
          alt={altText}
          class="w-8 h-8 md:w-9 md:h-9 object-contain"
          width="36"
          height="36"
        />
      ) : (
        <span class="text-2xl font-bold text-white">{number}</span>
      )}
    </div>

    <!-- Vertical Connecting Line (not shown for last step) -->
    {!isLast && (
      <div
        class="w-0.5 flex-1 bg-gradient-to-b from-accent/30 to-accent/10 mt-2"
        style="min-height: 60px;"
        aria-hidden="true"
      />
    )}
  </div>

  <!-- Right Column: Content -->
  <div class="flex-1 pb-8 md:pb-12">
    <h3 class="text-xl md:text-2xl font-semibold text-primary mb-2 md:mb-3">
      {title}
    </h3>
    <p class="text-base text-text-light/90 leading-relaxed">
      {description}
    </p>
  </div>
</div>
