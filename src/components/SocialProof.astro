---
import { siteConfig } from '@data/siteConfig';
import Container from './Container.astro';

const { socialProof } = siteConfig;

const icons = {
  lock: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>`,
  headset: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" /></svg>`,
  'shield-check': `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
};
---

<section class="border-y border-ui-light bg-white py-6">
  <Container>
    <div class="flex flex-col md:flex-row items-center justify-center gap-8 md:gap-16">
      {socialProof.items.map((item) => (
        <div class="flex items-center gap-3 text-text">
          <div class="text-accent flex-shrink-0" set:html={icons[item.icon as keyof typeof icons]} />
          <span class="font-medium whitespace-nowrap">{item.text}</span>
        </div>
      ))}
    </div>
  </Container>
</section>
