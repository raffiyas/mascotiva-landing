---
import { siteConfig } from '@data/siteConfig';
import Container from './Container.astro';
import Button from './Button.astro';

const { finalCta } = siteConfig;
---

<section id="demo" class="section-padding bg-gradient-to-br from-primary to-primary-700">
  <Container>
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-white mb-20">
        {finalCta.title}
      </h2>

      <p class="text-xl text-white/90 mb-32">
        {finalCta.subtitle}
      </p>

      <Button variant="secondary" size="lg" href={finalCta.cta.href} class="mb-20">
        {finalCta.cta.label}
      </Button>

      <p class="text-sm text-white/70 flex items-center justify-center gap-8">
        <svg class="w-16 h-16 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
        </svg>
        {finalCta.microcopy}
      </p>
    </div>
  </Container>
</section>
