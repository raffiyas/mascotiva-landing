---
/**
 * FeatureCard component - displays a single feature with optional image
 */

export interface Props {
  title: string;
  description: string;
  image?: string | null;
}

const { title, description, image } = Astro.props;

// Alt text mapping for feature images
const altTextMap: Record<string, string> = {
  '/images/feature-agenda.png': 'Vista de calendario semanal con citas veterinarias programadas',
  '/images/feature-ficha.png': 'Ficha clínica digital de un paciente con historial de consultas',
  '/images/feature-vacunas.png': 'Calendario de vacunación con alertas y próximos refuerzos',
};

const altText = image ? (altTextMap[image] || title) : title;
---

<div class="bg-white rounded-lg border border-ui-light p-24 md:p-32 hover:shadow-card transition-shadow duration-300">
  {image && (
    <div class="mb-20 rounded-lg overflow-hidden bg-ui-light aspect-video">
      <img
        src={image}
        alt={altText}
        class="w-full h-full object-cover"
        loading="lazy"
        width="400"
        height="225"
      />
    </div>
  )}

  <h3 class="text-xl md:text-2xl font-bold text-primary mb-12">
    {title}
  </h3>

  <p class="text-text-light leading-relaxed">
    {description}
  </p>
</div>
