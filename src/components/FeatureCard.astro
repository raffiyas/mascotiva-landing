---
/**
 * FeatureCard component - displays a single feature with optional image
 */

export interface Props {
  title: string;
  description: string;
  image?: string | null;
}

const { title, description, image } = Astro.props;
---

<div class="bg-white rounded-lg border border-ui-light p-24 md:p-32 hover:shadow-card transition-shadow duration-300">
  {image && (
    <div class="mb-20 rounded-lg overflow-hidden bg-ui-light aspect-video">
      <!-- Placeholder for feature image -->
      <div class="w-full h-full bg-gradient-to-br from-ui-light to-ui-muted/30 flex items-center justify-center">
        <div class="text-center p-16">
          <svg class="w-48 h-48 mx-auto mb-8 text-ui-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <p class="text-xs text-ui-muted">Imagen: {image}</p>
        </div>
      </div>
      <!-- Uncomment when image is available -->
      <!-- <img
        src={image}
        alt={title}
        class="w-full h-full object-cover"
        loading="lazy"
        width="400"
        height="225"
      /> -->
    </div>
  )}

  <h3 class="text-xl md:text-2xl font-bold text-primary mb-12">
    {title}
  </h3>

  <p class="text-text-light leading-relaxed">
    {description}
  </p>
</div>
