---
import { siteConfig } from '@data/siteConfig';
import Container from './Container.astro';
import Button from './Button.astro';

const { hero } = siteConfig;
---

<section class="section-padding bg-gradient-to-b from-ui-light/30 to-white">
  <Container>
    <div class="grid lg:grid-cols-2 gap-48 lg:gap-64 items-center">
      <!-- Left Column: Content -->
      <div class="space-y-24 lg:space-y-32">
        <!-- Badge -->
        <div class="inline-flex">
          <span class="inline-flex items-center px-16 py-8 rounded-full bg-accent/10 text-accent text-sm font-medium">
            {hero.badge}
          </span>
        </div>

        <!-- Heading -->
        <h1 class="text-balance">
          {hero.title}
        </h1>

        <!-- Subtitle -->
        <p class="text-lg md:text-xl text-text-light max-w-2xl">
          {hero.subtitle}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-16">
          <Button variant="primary" size="lg" href={hero.primaryCta.href}>
            {hero.primaryCta.label}
          </Button>
          <Button variant="secondary" size="lg" href={hero.secondaryCta.href}>
            {hero.secondaryCta.label}
          </Button>
        </div>

        <!-- Microcopy -->
        <p class="text-sm text-ui-muted flex items-center gap-8">
          <svg class="w-16 h-16 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          {hero.microcopy}
        </p>
      </div>

      <!-- Right Column: Hero Image -->
      <div class="relative">
        <div class="relative rounded-xl overflow-hidden shadow-hover">
          <!-- Placeholder for hero image -->
          <div class="aspect-[4/3] bg-gradient-to-br from-ui-light to-ui-muted/30 flex items-center justify-center">
            <div class="text-center p-32 max-w-md">
              <svg class="w-64 h-64 mx-auto mb-16 text-ui-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <p class="text-sm text-ui-muted">
                {hero.image.alt}
              </p>
              <p class="text-xs text-ui-muted mt-8">
                Imagen: {hero.image.src}
              </p>
            </div>
          </div>
          <!-- Uncomment when image is available -->
          <!-- <img
            src={hero.image.src}
            alt={hero.image.alt}
            class="w-full h-full object-cover"
            width="800"
            height="600"
            fetchpriority="high"
          /> -->
        </div>

        <!-- Decorative elements -->
        <div class="absolute -top-16 -right-16 w-96 h-96 bg-accent/10 rounded-full blur-3xl -z-10" aria-hidden="true"></div>
        <div class="absolute -bottom-16 -left-16 w-80 h-80 bg-primary/5 rounded-full blur-3xl -z-10" aria-hidden="true"></div>
      </div>
    </div>
  </Container>
</section>
