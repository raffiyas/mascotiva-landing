---
import { siteConfig } from '@data/siteConfig';
import Container from './Container.astro';
import Button from './Button.astro';

const { hero } = siteConfig;
---

<section class="section-padding bg-gradient-to-b from-ui-light/30 to-white">
  <Container>
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left Column: Content -->
      <div class="space-y-6 lg:space-y-8">
        <!-- Badge -->
        <div class="inline-flex">
          <span class="inline-flex items-center px-4 py-2 rounded-full bg-accent/10 text-accent text-sm font-medium">
            {hero.badge}
          </span>
        </div>

        <!-- Heading -->
        <h1 class="text-balance">
          {hero.title}
        </h1>

        <!-- Subtitle -->
        <p class="text-lg md:text-xl text-text-light max-w-2xl">
          {hero.subtitle}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4">
          <Button variant="primary" size="lg" href={hero.primaryCta.href}>
            {hero.primaryCta.label}
          </Button>
          <Button variant="secondary" size="lg" href={hero.secondaryCta.href}>
            {hero.secondaryCta.label}
          </Button>
        </div>

        <!-- Microcopy -->
        <p class="text-sm text-ui-muted flex items-center gap-2">
          <svg class="w-4 h-4 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          {hero.microcopy}
        </p>
      </div>

      <!-- Right Column: Hero Image -->
      <div class="relative">
        <div class="relative rounded-xl overflow-hidden shadow-hover">
          <img
            src={hero.image.src}
            alt={hero.image.alt}
            class="w-full h-full object-cover"
            width="800"
            height="600"
            fetchpriority="high"
          />
        </div>

        <!-- Decorative elements -->
        <div class="absolute -top-4 -right-4 w-24 h-24 bg-accent/10 rounded-full blur-3xl -z-10" aria-hidden="true"></div>
        <div class="absolute -bottom-4 -left-4 w-20 h-20 bg-primary/5 rounded-full blur-3xl -z-10" aria-hidden="true"></div>
      </div>
    </div>
  </Container>
</section>
