---
import { siteConfig } from '@data/siteConfig';
import Container from './Container.astro';
import BenefitCard from './BenefitCard.astro';

const { benefits } = siteConfig;
---

<section class="section-padding bg-gradient-to-b from-ui-light/30 to-white">
  <Container>
    <!-- Section Header -->
    <div class="text-center mb-48 md:mb-64">
      <h2 class="text-balance">
        {benefits.sectionTitle}
      </h2>
    </div>

    <!-- Benefits Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-32 md:gap-40">
      {benefits.items.map((benefit) => (
        <BenefitCard
          title={benefit.title}
          description={benefit.description}
          icon={benefit.icon}
        />
      ))}
    </div>
  </Container>
</section>
