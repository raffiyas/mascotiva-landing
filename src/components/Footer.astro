---
import { siteConfig } from '@data/siteConfig';
import Container from './Container.astro';
---

<footer id="contacto" class="bg-primary text-white pt-64 pb-32">
  <Container>
    <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-40 mb-48">
      <!-- Brand Column -->
      <div class="lg:col-span-2">
        <a href="/" class="inline-block mb-20" aria-label="Mascotiva - Inicio">
          <img
            src="/logos/logo-white.svg"
            alt="Mascotiva"
            class="h-8 w-auto"
            width="140"
            height="32"
          />
        </a>
        <p class="text-white/70 mb-20 max-w-sm">
          Software veterinario diseñado para clínicas modernas en Latinoamérica.
        </p>
        <div class="flex flex-col gap-12">
          <a
            href={`mailto:${siteConfig.email}`}
            class="text-white/90 hover:text-accent transition-colors inline-flex items-center gap-8"
          >
            <svg class="w-20 h-20 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {siteConfig.email}
          </a>
        </div>
      </div>

      <!-- Navigation Columns -->
      {siteConfig.footer.columns.map((column) => (
        <div>
          <h3 class="font-bold text-white mb-20">
            {column.title}
          </h3>
          <ul class="space-y-12">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-white/70 hover:text-accent transition-colors inline-flex items-center gap-8"
                >
                  {link.label}
                  {link.comingSoon && (
                    <span class="text-xs bg-white/10 px-8 py-4 rounded">Próximamente</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom Bar -->
    <div class="pt-32 border-t border-white/10">
      <div class="flex flex-col md:flex-row justify-between items-center gap-16">
        <p class="text-white/60 text-sm">
          {siteConfig.footer.copyright}
        </p>

        <div class="flex gap-24">
          <a
            href="/terminos"
            class="text-white/60 hover:text-accent text-sm transition-colors"
          >
            Términos
          </a>
          <a
            href="/privacidad"
            class="text-white/60 hover:text-accent text-sm transition-colors"
          >
            Privacidad
          </a>
        </div>
      </div>
    </div>
  </Container>
</footer>
